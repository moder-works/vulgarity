<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>Vulgarity</RootNamespace>
    <AssemblyName>Vulgarity</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Vulgarity</PackageId>
    <Version>0.1.0</Version>
    <Description>
      Trie-based vulgarity detection, filtering and scoring. It defeats leetspeak,
      separator and repeated-letter evasion. A matching Dart package shares the
      same seed data and the same test vectors.
    </Description>
    <PackageTags>profanity;moderation;filter;trie;aho-corasick</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/moder-works/vulgarity</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!--
      data/ is the contract both languages read. Neither one owns it.

      The packs ship, not the JSON. A pack carries the same terms in a masked
      form, so this assembly holds no readable term. data/*.json stays the
      authored source. Regenerate with: python3 tool/gen_packs.py

      The file names use a hyphen, not a dot. MSBuild reads a `.<code>.` segment
      as a culture, so "seed.de.vpk" would move into a German satellite
      assembly and leave the main one without it. "seed-de.vpk" does not.
    -->
    <EmbeddedResource Include="../../../data/packs/seed-en.vpk" LogicalName="Vulgarity.seed-en.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-ar.vpk" LogicalName="Vulgarity.seed-ar.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-de.vpk" LogicalName="Vulgarity.seed-de.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-es.vpk" LogicalName="Vulgarity.seed-es.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-fa.vpk" LogicalName="Vulgarity.seed-fa.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-fr.vpk" LogicalName="Vulgarity.seed-fr.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-hi.vpk" LogicalName="Vulgarity.seed-hi.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-it.vpk" LogicalName="Vulgarity.seed-it.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-ko.vpk" LogicalName="Vulgarity.seed-ko.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-nl.vpk" LogicalName="Vulgarity.seed-nl.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-pl.vpk" LogicalName="Vulgarity.seed-pl.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-ru.vpk" LogicalName="Vulgarity.seed-ru.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-th.vpk" LogicalName="Vulgarity.seed-th.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-vi.vpk" LogicalName="Vulgarity.seed-vi.vpk" />
    <EmbeddedResource Include="../../../data/packs/seed-zh.vpk" LogicalName="Vulgarity.seed-zh.vpk" />
  </ItemGroup>


  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Vulgarity.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
